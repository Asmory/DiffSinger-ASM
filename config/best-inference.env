# Common kernel defaults retained for benchmark reproduction. Product callers
# select the current champions through ABI v3 modes:
#   realtime streaming: 4 workers, 32-frame regions and bucket, 8-frame overlap
#   block batch:         8 workers, 384-frame regions and bucket, no overlap
# Shape-specific VNNI and paired ConvTranspose additions are enabled by runtime
# defaults and must remain unset here so each mode receives its own gated set.
unset DSASM_VNNI_EXTRA_OPS
unset DSASM_CONVT_S2K4_OC2
export DSASM_2D=1
export DSASM_KSPEC=0
export DSASM_PARALLEL_ADD=1
export DSASM_PARALLEL_LEAKY_COPY=1
export DSASM_VOCODER_T_TILE=2016
export DSASM_RANGE_T24=1
export DSASM_RANGE_RESIDUAL_T24=1
export DSASM_RESIDUAL_T24=1
export DSASM_K3_TMODE=24
export DSASM_K7_T24=1
export DSASM_K11_T24=1
export DSASM_VNNI=k117
export DSASM_VNNI_ASYM=1
export DSASM_VNNI_CIN=128,64

# Quality gates are used when --golden is supplied to the vocoder CLI.
export DSASM_GOLDEN_COS=0.999
export DSASM_GOLDEN_SNR=25
