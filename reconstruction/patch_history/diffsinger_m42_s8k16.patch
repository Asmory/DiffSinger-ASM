index 0000000..52dfc1d
--- /dev/null
+++ b/scripts/run_m42_s8k16.sh
@@ -0,0 +1,66 @@
+#!/usr/bin/env bash
+set -euo pipefail
+PROJECT="${PROJECT:-/home/fuurin/asm/diffsinger}"
+MODEL="${MODEL:-$PROJECT/model/DongFangZhiZi_Nectar_DiffSinger_CE_26.08.31}"
+PY="${PY:-$PROJECT/.venv/bin/python}"
+ROUNDS="${M42_ROUNDS:-9}"
+cd "$PROJECT"
+
+make -j"$(nproc)" build/dsasm-vocoder-m40 build/dsasm-acoustic
+mkdir -p build/m42
+
+# Direct kernel parity against the old generic scatter kernel.
+cc -Iinclude -O3 -march=native tools/test_convtranspose_s8k16_m42.c \
+  build/convtranspose_m33.o -lm -o build/m42/test_s8k16
+./build/m42/test_s8k16
+
+BUNDLE=build/m41_profile/nsf_hifigan.dsv35
+WORK=build/m41_profile/packer
+if [[ ! -f "$BUNDLE" || ! -f "$WORK/mel.f32" ]]; then
+  mkdir -p build/m41_profile
+  rm -rf "$WORK"; mkdir -p "$WORK"
+  "$PY" tools/pack_vocoder_graph_m35.py \
+    "$MODEL/dsvocoder/nsf_hifigan.onnx" \
+    --frames 48 --vnni-scope stage128 --out "$BUNDLE" --work "$WORK"
+fi
+MEL="$WORK/mel.f32"; F0="$WORK/f0.f32"; GOLD="$WORK/golden_wave.f32"
+
+run_vocoder(){
+  local tag="$1" toggle="$2"
+  echo
+  echo "========== M42 $tag =========="
+  DSASM_CONVT_S8K16="$toggle" DSASM_VNNI=k11 DSASM_KSPEC=1 \
+  DSASM_PROFILE_SHAPES=1 DSASM_GOLDEN_COS=0.999 DSASM_GOLDEN_SNR=25 \
+  ./build/dsasm-vocoder-m40 infer "$BUNDLE" \
+    --mel "$MEL" --f0 "$F0" --out "build/m42/${tag}.f32" --golden "$GOLD" \
+    --workers 8 --rounds "$ROUNDS" --profile 2>&1 | tee "build/m42/${tag}.log"
+}
+run_vocoder generic_s8k16_off 0
+run_vocoder asm_s8k16_on 1
+
+printf '\n========== M42 VOCODER A/B SUMMARY ==========\n'
+for f in build/m42/generic_s8k16_off.log build/m42/asm_s8k16_on.log; do
+  echo "--- $(basename "$f") ---"
+  grep -E 'PURE-ASM vocoder:|parity max_abs=|^  ConvTranspose|#060 ConvT|#027 ConvT|#095 ConvT' "$f" || true
+done
+
+# Re-run the actual CPU/C/ASM end-to-end path with the new 8-worker vocoder.
+ACOUSTIC=build/m42_acoustic
+if [[ ! -f "$ACOUSTIC/model.json" ]]; then
+  rm -rf "$ACOUSTIC"
+  "$PY" tools/pack_acoustic_onnx_m25.py "$MODEL/acoustic.onnx" \
+    --model-dir "$MODEL" --out "$ACOUSTIC"
+fi
+rm -rf build/m42_e2e
+DSASM_CONVT_S8K16=1 "$PY" tools/run_native_e2e_m40_1.py \
+  --packed-acoustic "$ACOUSTIC" \
+  --acoustic-cli ./build/dsasm-acoustic \
+  --vocoder-bundle "$BUNDLE" \
+  --vocoder-cli ./build/dsasm-vocoder-m40 \
+  --vocoder-onnx "$MODEL/dsvocoder/nsf_hifigan.onnx" \
+  --speaker-emb "$MODEL/dongfangzhizi-nectar-xiao.emb" \
+  --language-id 4 --depth 0.6 --steps 4 --workers 8 --rounds "$ROUNDS" --modes k11 \
+  --work build/m42_e2e 2>&1 | tee build/m42/e2e.log
+
+printf '\n========== M42 FINAL ==========\n'
+grep -E 'M40\.1 PURE CPU/C/ASM E2E|realtime RTF|PURE-ASM vocoder:|parity max_abs=' build/m42/e2e.log || true
diff --git a/src/kernels/x86_64/convtranspose1d_nct_f32_avx2.S b/src/kernels/x86_64/convtranspose1d_nct_f32_avx2.S
index ec416df..ea42763 100644
--- a/src/kernels/x86_64/convtranspose1d_nct_f32_avx2.S
+++ b/src/kernels/x86_64/convtranspose1d_nct_f32_avx2.S
@@ -274,4 +274,232 @@ ds_convtranspose1d_s2k4_oc_f32_avx2:
     pop rbp
     ret
 .size ds_convtranspose1d_s2k4_oc_f32_avx2,.-ds_convtranspose1d_s2k4_oc_f32_avx2
+
+
+# M42 specialized NSF-HiFiGAN early upsampler:
+#   stride=8, K=16, pad=4, dilation=1, output_padding=0, Tout=8*Tin.
+# One output channel per call. Weight layout [Cin,16] in original ONNX tap order.
+#
+# The generic kernel scatters each x[t] into sixteen y samples and therefore
+# read/modify/writes the output once per input channel. Here we invert the loop:
+# keep output samples in registers across the complete Cin reduction and store
+# each y sample only once. For output block n (samples 8n..8n+7):
+#   lo[0:4] = b + sum_ci x[n]  * w[4:8]  + x[n-1] * w[12:16]
+#   hi[0:4] = b + sum_ci x[n]  * w[8:12] + x[n+1] * w[0:4]
+# Four adjacent output blocks are computed together so each 16-float weight row
+# is loaded once for 32 output samples.
+#
+# void ds_convtranspose1d_s8k16_oc_f32_avx2(
+#   const float *x,      // rdi [Cin,Tin]
+#   const float *w_oc,   // rsi [Cin,16]
+#   float bias,          // xmm0
+#   float *y,            // rdx [8*Tin]
+#   size_t Cin,          // rcx
+#   size_t Tin           // r8
+# );
+.globl ds_convtranspose1d_s8k16_oc_f32_avx2
+.type ds_convtranspose1d_s8k16_oc_f32_avx2,@function
+ds_convtranspose1d_s8k16_oc_f32_avx2:
+    push rbp
+    mov rbp,rsp
+    push rbx
+    push r12
+    push r13
+    push r14
+    push r15
+    sub rsp,16
+
+    test rcx,rcx
+    jz .s8_done
+    test r8,r8
+    jz .s8_done
+
+    mov r12,rdi                    # x base
+    mov r13,rsi                    # w base
+    mov r14,rdx                    # y base
+    mov r15,rcx                    # Cin
+    mov rbx,r8                     # Tin
+    vmovss DWORD PTR [rsp],xmm0    # bias
+    mov rax,rbx
+    shl rax,2
+    mov QWORD PTR [rsp+8],rax      # input row bytes
+
+    # n=0: no x[n-1] contribution.
+    vbroadcastss xmm0,DWORD PTR [rsp]
+    vmovaps xmm1,xmm0
+    mov r10,r12
+    mov r11,r13
+    mov rcx,r15
+.s8_first_ci:
+    vmovups xmm8,XMMWORD PTR [r11]       # w0..3
+    vmovups xmm9,XMMWORD PTR [r11+16]    # w4..7
+    vmovups xmm10,XMMWORD PTR [r11+32]   # w8..11
+    vbroadcastss xmm12,DWORD PTR [r10]
+    vfmadd231ps xmm0,xmm12,xmm9
+    vfmadd231ps xmm1,xmm12,xmm10
+    cmp rbx,1
+    jbe .s8_first_no_next
+    vbroadcastss xmm12,DWORD PTR [r10+4]
+    vfmadd231ps xmm1,xmm12,xmm8
+.s8_first_no_next:
+    add r10,QWORD PTR [rsp+8]
+    add r11,64
+    dec rcx
+    jnz .s8_first_ci
+    vmovups XMMWORD PTR [r14],xmm0
+    vmovups XMMWORD PTR [r14+16],xmm1
+
+    cmp rbx,1
+    jbe .s8_done
+    mov r9,1                      # next output block n
+
+.s8_group_check:
+    lea rax,[r9+4]
+    cmp rax,rbx
+    jae .s8_tail
+
+    # Four interior blocks n..n+3. All prev/current/next accesses valid.
+    vbroadcastss xmm0,DWORD PTR [rsp]
+    vmovaps xmm1,xmm0
+    vmovaps xmm2,xmm0
+    vmovaps xmm3,xmm0
+    vmovaps xmm4,xmm0
+    vmovaps xmm5,xmm0
+    vmovaps xmm6,xmm0
+    vmovaps xmm7,xmm0
+
+    lea r10,[r12+r9*4]
+    mov r11,r13
+    mov rcx,r15
+.s8_group_ci:
+    vmovups xmm8,XMMWORD PTR [r11]       # w0..3
+    vmovups xmm9,XMMWORD PTR [r11+16]    # w4..7
+    vmovups xmm10,XMMWORD PTR [r11+32]   # w8..11
+    vmovups xmm11,XMMWORD PTR [r11+48]   # w12..15
+
+    # x[n-1]
+    vbroadcastss xmm12,DWORD PTR [r10-4]
+    vfmadd231ps xmm0,xmm12,xmm11
+
+    # x[n]
+    vbroadcastss xmm12,DWORD PTR [r10]
+    vfmadd231ps xmm0,xmm12,xmm9
+    vfmadd231ps xmm1,xmm12,xmm10
+    vfmadd231ps xmm2,xmm12,xmm11
+
+    # x[n+1]
+    vbroadcastss xmm12,DWORD PTR [r10+4]
+    vfmadd231ps xmm1,xmm12,xmm8
+    vfmadd231ps xmm2,xmm12,xmm9
+    vfmadd231ps xmm3,xmm12,xmm10
+    vfmadd231ps xmm4,xmm12,xmm11
+
+    # x[n+2]
+    vbroadcastss xmm12,DWORD PTR [r10+8]
+    vfmadd231ps xmm3,xmm12,xmm8
+    vfmadd231ps xmm4,xmm12,xmm9
+    vfmadd231ps xmm5,xmm12,xmm10
+    vfmadd231ps xmm6,xmm12,xmm11
+
+    # x[n+3]
+    vbroadcastss xmm12,DWORD PTR [r10+12]
+    vfmadd231ps xmm5,xmm12,xmm8
+    vfmadd231ps xmm6,xmm12,xmm9
+    vfmadd231ps xmm7,xmm12,xmm10
+
+    # x[n+4]
+    vbroadcastss xmm12,DWORD PTR [r10+16]
+    vfmadd231ps xmm7,xmm12,xmm8
+
+    add r10,QWORD PTR [rsp+8]
+    add r11,64
+    dec rcx
+    jnz .s8_group_ci
+
+    mov rax,r9
+    shl rax,5                      # byte offset = n*8 floats*4
+    vmovups XMMWORD PTR [r14+rax],xmm0
+    vmovups XMMWORD PTR [r14+rax+16],xmm1
+    vmovups XMMWORD PTR [r14+rax+32],xmm2
+    vmovups XMMWORD PTR [r14+rax+48],xmm3
+    vmovups XMMWORD PTR [r14+rax+64],xmm4
+    vmovups XMMWORD PTR [r14+rax+80],xmm5
+    vmovups XMMWORD PTR [r14+rax+96],xmm6
+    vmovups XMMWORD PTR [r14+rax+112],xmm7
+    add r9,4
+    jmp .s8_group_check
+
+.s8_tail:
+    cmp r9,rbx
+    jae .s8_done
+    lea rax,[r9+1]
+    cmp rax,rbx
+    jae .s8_last
+
+    # One interior block.
+    vbroadcastss xmm0,DWORD PTR [rsp]
+    vmovaps xmm1,xmm0
+    lea r10,[r12+r9*4]
+    mov r11,r13
+    mov rcx,r15
+.s8_single_ci:
+    vmovups xmm8,XMMWORD PTR [r11]
+    vmovups xmm9,XMMWORD PTR [r11+16]
+    vmovups xmm10,XMMWORD PTR [r11+32]
+    vmovups xmm11,XMMWORD PTR [r11+48]
+    vbroadcastss xmm12,DWORD PTR [r10]
+    vfmadd231ps xmm0,xmm12,xmm9
+    vfmadd231ps xmm1,xmm12,xmm10
+    vbroadcastss xmm12,DWORD PTR [r10-4]
+    vfmadd231ps xmm0,xmm12,xmm11
+    vbroadcastss xmm12,DWORD PTR [r10+4]
+    vfmadd231ps xmm1,xmm12,xmm8
+    add r10,QWORD PTR [rsp+8]
+    add r11,64
+    dec rcx
+    jnz .s8_single_ci
+    mov rax,r9
+    shl rax,5
+    vmovups XMMWORD PTR [r14+rax],xmm0
+    vmovups XMMWORD PTR [r14+rax+16],xmm1
+    inc r9
+    jmp .s8_tail
+
+.s8_last:
+    # n=Tin-1: no x[n+1] contribution.
+    vbroadcastss xmm0,DWORD PTR [rsp]
+    vmovaps xmm1,xmm0
+    lea r10,[r12+r9*4]
+    mov r11,r13
+    mov rcx,r15
+.s8_last_ci:
+    vmovups xmm9,XMMWORD PTR [r11+16]
+    vmovups xmm10,XMMWORD PTR [r11+32]
+    vmovups xmm11,XMMWORD PTR [r11+48]
+    vbroadcastss xmm12,DWORD PTR [r10]
+    vfmadd231ps xmm0,xmm12,xmm9
+    vfmadd231ps xmm1,xmm12,xmm10
+    vbroadcastss xmm12,DWORD PTR [r10-4]
+    vfmadd231ps xmm0,xmm12,xmm11
+    add r10,QWORD PTR [rsp+8]
+    add r11,64
+    dec rcx
+    jnz .s8_last_ci
+    mov rax,r9
+    shl rax,5
+    vmovups XMMWORD PTR [r14+rax],xmm0
+    vmovups XMMWORD PTR [r14+rax+16],xmm1
+
+.s8_done:
+    vzeroupper
+    add rsp,16
+    pop r15
+    pop r14
+    pop r13
+    pop r12
+    pop rbx
+    pop rbp
+    ret
+.size ds_convtranspose1d_s8k16_oc_f32_avx2,.-ds_convtranspose1d_s8k16_oc_f32_avx2
+
 .section .note.GNU-stack,"",@progbits
