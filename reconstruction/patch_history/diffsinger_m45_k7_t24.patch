index 91cd3d0..1e70c95 100644
--- a/src/kernels/x86_64/conv1d_nct_f32_avx2_oc8_t8_kspec.S
+++ b/src/kernels/x86_64/conv1d_nct_f32_avx2_oc8_t8_kspec.S
@@ -1360,4 +1360,172 @@ ds_conv1d_nct_f32_avx2_oc8_t8_range_k11:
     pop rbp
