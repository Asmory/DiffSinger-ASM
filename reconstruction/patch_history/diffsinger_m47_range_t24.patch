+static int one(size_t K,size_t Cin,size_t T,size_t d,size_t t0,size_t tc,int bench){
+ const size_t pad=(K/2)*d,Tp=T+2*pad,nx=Cin*Tp,nw=Cin*K*8,ny=8*T;
