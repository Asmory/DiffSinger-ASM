 int ds_threadpool_get_2d(const DSAsmThreadPool *p){return p?p->use_2d:0;}
 void ds_threadpool_set_atan_pipeline(DSAsmThreadPool *p,int enabled){if(p)p->atan_pipeline=!!enabled;}
